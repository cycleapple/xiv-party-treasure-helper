<Project Sdk="Dalamud.NET.Sdk/13.0.0">
    <PropertyGroup>
        <PlatformTarget>x64</PlatformTarget>
        <TargetFramework>net9.0-windows</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Platforms>x64</Platforms>
        <Configurations>Debug;Release</Configurations>
        <Version>0.1.9.4</Version>
        <AssemblyVersion>0.1.9.4</AssemblyVersion>
        <FileVersion>0.1.9.4</FileVersion>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <Deterministic>true</Deterministic>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    </PropertyGroup>

    <!-- 指向繁中服 (yanmucorp) Dalamud API13 Hooks。 -->
    <PropertyGroup>
        <DalamudLibPath Condition="'$(DALAMUD_HOME)' == ''">$(AppData)\FFXIVSimpleLauncher\Dalamud\Hooks\13.0.0.8\</DalamudLibPath>
        <AssemblySearchPaths>$(DalamudLibPath);$(AssemblySearchPaths)</AssemblySearchPaths>
    </PropertyGroup>
</Project>
